# Optional. Everything has a safe default; the demo needs no tenant and no credentials.
# PORT must be in 5010-5049 (5000 is taken by the OS).
PORT=5010
# AREG_BIND=127.0.0.1   # loopback only unless you set this on purpose
# HOSTED=1 marks a hosted build: the Mock/Real toggle is then locked to Mock (POST /api/mode answers 403).
# HOSTED=1
